<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.edu.mapper.AramTypeMapper">
	<resultMap type="AramType" id="aramTypeResultMap">
		<id property="id" column="id" />
		<result property="stype" column="t_stype" />
		<result property="bz" column="t_bz" />
		<result property="addTime" column="addTime" />
	</resultMap>

	<delete id="deleteById" parameterType="int">
		delete from t_aramType where id=#{id};
	</delete>

	<select id="getById" parameterType="int" resultMap="aramTypeResultMap">
		SELECT t_aramType.id,
			   t_aramType.t_stype,
			   t_aramType.t_bz,
			   t_aramType.addTime
		  FROM t_aramType
		 WHERE t_aramType.id = #{id}
	</select>

	<select id="getList"  resultMap="aramTypeResultMap" parameterType="java.util.Map">
		SELECT t_aramType.id,
			   t_aramType.t_stype,
			   t_aramType.t_bz,
			   t_aramType.addTime
		  FROM t_aramType
		 WHERE 1 = 1
		<if test="field == 'stype'">
			and t_aramType.t_stype like '%${fieldValue}%'
		</if>
		<if test="field == 'bz'">
			and t_aramType.t_bz like '%${fieldValue}%'
		</if>
		<if test="field == 'addTime'">
			and t_aramType.addTime like '%${fieldValue}%'
		</if>
	</select>

	<insert id="insert" parameterType="AramType">
		INSERT INTO t_aramType(addTime,t_stype, t_bz)
				VALUES(#{addTime},#{stype}, #{bz})
	</insert>

	<update id="update" parameterType="AramType">
		UPDATE t_aramType set t_stype=#{stype}, t_bz=#{bz}
				where id=#{id}
	</update>

</mapper>

