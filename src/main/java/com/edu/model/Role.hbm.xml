<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
	<class name="com.edu.model.Role" table="t_Role">
		<comment>角色管理表</comment>
		<id name="id">
			<generator class="native" />
		</id>
		<property name="name" >
			<column name="t_name" >
				<comment>角色名称</comment>
			</column>
		</property>
		<property name="bz" >
			<column name="t_bz"  length="5000">
				<comment>备注</comment>
			</column>
		</property>
		<property name="addTime" type="calendar">
			<column name="addTime">
				<comment>插入数据库时间</comment>
			</column>
		</property>
	</class>
</hibernate-mapping>