<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
	<class name="com.edu.model.AlarmStats" table="t_AlarmStats">
		<comment>报警类型统计表</comment>
		<id name="id">
			<generator class="native" />
		</id>
		<property name="count" >
			<column name="t_count" >
				<comment>次数</comment>
			</column>
		</property>
		<property name="date" >
			<column name="t_date" >
				<comment>日期</comment>
			</column>
		</property>
		<property name="bz" >
			<column name="t_bz"  length="5000">
				<comment>备注</comment>
			</column>
		</property>
		<property name="addTime" type="calendar">
			<column name="addTime">
				<comment>插入数据库时间</comment>
			</column>
		</property>
		<many-to-one name="oilFieldInfo"  class="com.edu.model.OilFieldInfo" outer-join="false" lazy="false">
			<column name="oilFieldInfo_id">
				<comment>对应OilFieldInfo表的ID，在这里作为外键</comment>
			</column>
		</many-to-one>
		<many-to-one name="aramType"  class="com.edu.model.AramType" outer-join="false" lazy="false">
			<column name="aramType_id">
				<comment>对应AramType表的ID，在这里作为外键</comment>
			</column>
		</many-to-one>
	</class>
</hibernate-mapping>