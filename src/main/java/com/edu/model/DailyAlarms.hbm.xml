<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
	<class name="com.edu.model.DailyAlarms" table="t_DailyAlarms">
		<comment>当日报警情况表</comment>
		<id name="id">
			<generator class="native" />
		</id>
		<property name="status" >
			<column name="t_status" >
				<comment>状态</comment>
			</column>
		</property>
		<property name="time" >
			<column name="t_time" >
				<comment>时间</comment>
			</column>
		</property>
		<property name="location" >
			<column name="t_location" >
				<comment>位置</comment>
			</column>
		</property>
		<property name="bz" >
			<column name="t_bz"  length="5000">
				<comment>备注</comment>
			</column>
		</property>
		<property name="addTime" type="calendar">
			<column name="addTime">
				<comment>插入数据库时间</comment>
			</column>
		</property>
		<many-to-one name="oilFieldInfo"  class="com.edu.model.OilFieldInfo" outer-join="false" lazy="false">
			<column name="oilFieldInfo_id">
				<comment>对应OilFieldInfo表的ID，在这里作为外键</comment>
			</column>
		</many-to-one>
		<many-to-one name="sensorType"  class="com.edu.model.SensorType" outer-join="false" lazy="false">
			<column name="sensorType_id">
				<comment>对应SensorType表的ID，在这里作为外键</comment>
			</column>
		</many-to-one>
	</class>
</hibernate-mapping>