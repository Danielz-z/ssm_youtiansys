<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
	<class name="com.edu.model.OilFieldInfo" table="t_OilFieldInfo">
		<comment>油田基本情况表</comment>
		<id name="id">
			<generator class="native" />
		</id>
		<property name="location" >
			<column name="t_location" >
				<comment>位置</comment>
			</column>
		</property>
		<property name="status" >
			<column name="t_status" >
				<comment>当前状态</comment>
			</column>
		</property>
		<property name="production" >
			<column name="t_production" >
				<comment>日产量</comment>
			</column>
		</property>
		<property name="bz" >
			<column name="t_bz"  length="5000">
				<comment>备注</comment>
			</column>
		</property>
		<property name="addTime" type="calendar">
			<column name="addTime">
				<comment>插入数据库时间</comment>
			</column>
		</property>
	</class>
</hibernate-mapping>